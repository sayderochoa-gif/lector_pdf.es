# =====================================================================
# LectorPDF - Environment Configuration
# =====================================================================

# App Settings
DEBUG=false
MAX_UPLOAD_SIZE=104857600   # 100 MB in bytes
RENDER_DPI=150

# OCR Configuration
TESSERACT_CMD=/usr/bin/tesseract
TESSERACT_LANG=spa+eng

# AI / Vision Configuration (Local by default, zero external API keys needed)
ONNX_MODEL_URL=https://github.com/onnx/models/raw/main/validated/vision/classification/mobilenet/model/mobilenetv2-7.onnx

# Optional Cloud AI (fallback if enabled)
ENABLE_CLOUD_AI=false
OPENAI_API_KEY=
